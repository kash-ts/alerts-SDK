{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "node",
    "lib": [
      "ES2020"
    ],
    "outDir": "./dist",
    "rootDir": "./",
    "baseUrl": ".",
    "paths": {
      "@websocket/*": [
        "./src/WebSocket/*"
      ],
      "@type": [
        "./src/Types/index.ts"
      ],
      "@utils": [
        "./src/utils.ts"
      ],
      "@function/*": [
        "./src/Function/*"
      ],
    },
    "strict": true,
    "noImplicitAny": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "src/example"
  ]
}